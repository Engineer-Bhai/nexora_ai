# ============================================================
# Nexora AI — Environment Configuration Template
# IBM Bob 2.0 Hackathon — Autonomous SDLC Modernization Platform
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (already in .gitignore).
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# For local dev: http://localhost:5173
# For production: your Vercel frontend URL (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local MongoDB (default) or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nexora

# --- Authentication ---
# IMPORTANT: Replace with a strong random secret in production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# --- LLM Providers ---
# Configure at least one provider for full agent functionality.
# Without a key, Nexora uses its built-in semantic fallback engine
# (demonstrations work without an API key).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- RAG / Vector Settings ---
# Dimension of embedding vectors (1536 for OpenAI, 128 for fallback)
VECTOR_DIMENSIONS=1536

# --- Email / SMTP (Optional — for sensitive tool demo) ---
# Required only if you want live email dispatch via email_dispatch tool.
# Nexora works fully in demo mode without SMTP configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
